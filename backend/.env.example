PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
ENCRYPTION_KEY=your_encryption_key

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=KeyZen Security <your_email@gmail.com>

# Cloud Email Options (Recommended for Render Free Tier which blocks SMTP):
# Option A: Brevo API (Sends to ANY email globally, 300/day free, No domain needed):
BREVO_API_KEY=xkeysib-your_brevo_api_key

# Option B: Resend API (Free sandbox only sends to registered email):
RESEND_API_KEY=re_your_free_resend_api_key

# Option C: Disable OTP completely for direct password login:
# DISABLE_OTP=true
