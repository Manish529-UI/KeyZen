PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
ENCRYPTION_KEY=your_encryption_key

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=KeyZen Security <your_email@gmail.com>

# Cloud Email Options (Recommended for Render Free Tier which blocks SMTP):
RESEND_API_KEY=re_your_free_resend_api_key
# Or disable OTP completely for direct login:
# DISABLE_OTP=true
